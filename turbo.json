{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "dev": {
            "persistent": true,
            "cache": false
        },
        "build": {
            "dependsOn": ["format:check", "lint", "typecheck"],
            "outputs": ["dist/**", "storybook-static/**"]
        },
        "format:write": {
            "cache": false
        },
        "format:check": {},
        "lint": {},
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "@stuf/prisma#typecheck": {
            "dependsOn": ["generate", "^typecheck"]
        },
        "generate": {
            "outputs": ["generated/prisma/**"]
        },
        "test": {
            "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
        }
    }
}
