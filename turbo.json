{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "dev": {
            "persistent": true,
            "cache": false
        },
        "build": {
            "dependsOn": ["format:check", "lint"],
            "outputs": ["dist/**"]
        },
        "format:write": {
            "cache": false
        },
        "format:check": {},
        "lint": {}
    }
}
