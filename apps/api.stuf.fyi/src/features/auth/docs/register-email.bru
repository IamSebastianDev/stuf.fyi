meta {
  name: register-email
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/passkeys/register/email
  body: json
  auth: none
}

body:json {
  {
    "email": "signup@example.test"
  }
}

assert {
  res.status: eq 204
}

docs {
  Open Mailpit at http://localhost:8025 and copy the token from the verification link into register-options.
}
