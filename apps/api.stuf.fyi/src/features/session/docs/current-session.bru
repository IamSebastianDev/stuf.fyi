meta {
  name: current-session
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/auth/session
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Restores the signed-in user and their registered passkeys from the browser's session cookie. The frontend uses this on a fresh load. Passkey sign-in and registration return the same data.
}
