{
    "name": "api.stuf.fyi",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nest start --watch --env-file ../../.env --rspackPath rspack.config.ts",
        "build": "nest build --rspackPath rspack.config.ts",
        "start": "node --env-file=../../.env dist/main.js",
        "format:write": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --type-aware ."
    },
    "dependencies": {
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/platform-express": "^12.0.1",
        "@nestjs/platform-fastify": "^12.1.2",
        "@nestjs/platform-socket.io": "^12.1.2",
        "@nestjs/websockets": "^12.1.2",
        "@stuf/contracts": "*",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.4"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@repository/config": "*",
        "@rspack/cli": "^2.2.8",
        "@rspack/core": "^2.2.8",
        "@types/express": "^5.0.0",
        "@types/node": "^26.0.0",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^7.0.2001",
        "source-map-support": "^0.5.21",
        "tsconfig-paths-webpack-plugin": "^4.2.0",
        "typescript": "^6.0.2",
        "webpack-node-externals": "^3.0.0"
    }
