{
    "name": "@stuf/bits",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        "./avatar": "./src/avatar/avatar.ts",
        "./avatar.css": "./src/avatar/avatar.css",
        "./badge": "./src/badge/badge.ts",
        "./badge.css": "./src/badge/badge.css",
        "./button": "./src/button/button.ts",
        "./button.css": "./src/button/button.css",
        "./checkbox": "./src/checkbox/checkbox.ts",
        "./control-container": "./src/control-container/control-container.ts",
        "./icon": "./src/icon/icon.ts",
        "./icon.css": "./src/icon/icon.css",
        "./progress-bar": "./src/progress-bar/progress-bar.ts",
        "./progress-bar.css": "./src/progress-bar/progress-bar.css",
        "./separator": "./src/separator/separator.ts",
        "./separator.css": "./src/separator/separator.css",
        "./status-indicator": "./src/status-indicator/status-indicator.ts",
        "./status-indicator.css": "./src/status-indicator/status-indicator.css",
        "./surface": "./src/surface/surface.ts",
        "./surface.css": "./src/surface/surface.css",
        "./switch": "./src/switch/switch.ts",
        "./text": "./src/text/text.ts",
        "./text.css": "./src/text/text.css",
        "./text-field": "./src/text-field/text-field.ts",
        "./theme.css": "./src/theme/index.css",
        "./tokens.css": "./src/theme/index.css"
    },
    "scripts": {
        "dev": "storybook dev --port 5175 --exact-port --host 127.0.0.1 --no-open --disable-telemetry",
        "build": "npm run build:preview",
        "build:preview": "storybook build --disable-telemetry",
        "format:write": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@fontsource-variable/geist": "5.3.0",
        "lucide": "1.38.0"
    },
    "devDependencies": {
        "@grainular/forms": "2.4.0",
        "@grainular/grains": "2.4.0",
        "@grainular/nord": "2.4.0",
        "@repository/config": "*",
        "@storybook/addon-a11y": "10.6.7",
        "@storybook/addon-docs": "10.6.7",
        "@storybook/addon-vitest": "10.6.7",
        "@storybook/html-vite": "10.6.7",
        "@types/react": "^19.3.0",
        "@vitest/browser-playwright": "4.1.12",
        "playwright": "^1.58.2",
        "react": "^19.3.0",
        "storybook": "10.6.7",
        "vite": "^8.2.2",
        "vitest": "4.1.12"
    },
    "peerDependencies": {
        "@grainular/forms": "^2.4.0",
        "@grainular/grains": "^2.4.0",
        "@grainular/nord": "^2.4.0"
    }
