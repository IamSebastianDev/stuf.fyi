/// The named avatar colors offered in profile settings.
enum ProfileColor {
  MINT
  BLUE
  AMBER
  CORAL
  VIOLET
}

/// The application identity associated with one or more passkeys.
///
/// Users are intentionally not identified by email or password. The
/// webAuthnUserId is the stable opaque identifier supplied to WebAuthn.
model User {
  id              String              @id @default(uuid())
  webAuthnUserId  String              @unique
  /// Optional account-wide display name used as the default when creating or joining a list.
  displayName     String?
  /// Account-wide avatar color used as the default when creating or joining a list.
  profileColor    ProfileColor        @default(BLUE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  disabledAt      DateTime?
  passkeys        PasskeyCredential[]
  sessions        Session[]
  challenges      WebAuthnChallenge[]
  ownedLists      List[]              @relation("ListOwner")
  listMemberships ListMember[]
}
